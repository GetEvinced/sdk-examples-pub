# LambdaTest credentials — from https://app.lambdatest.com/settings/profile
LT_USERNAME=your-lambdatest-username
LT_ACCESS_KEY=your-lambdatest-access-key

# Evinced credentials — from https://hub.evinced.com (Automation for Web → Get SDK)
EVINCED_SERVICE_ID=your-evinced-service-id
EVINCED_API_KEY=your-evinced-api-key

# Target URL for accessibility scanning
TEST_URL=https://demo.evinced.com/
